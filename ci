#!/bin/sh
# CI del Project (contratto ./ci [sezione…], nessun argomento = tutto): nessun segreto, nessuna rete,
# esce al primo controllo fallito.
#   backend   sintassi e test (parser, server, sicurezza, interfaccia se c'è Chromium)
set -eu
cd "$(dirname "$0")"

backend() {
	for f in server.js lib/*.js public/*.js; do
		[ -f "$f" ] && node --check "$f"
	done
	node --test test/*.test.js
}

[ $# -gt 0 ] || set -- backend
for section in "$@"; do
	case $section in
	backend) echo "== ./ci $section" && "$section" ;;
	*) echo "./ci: sezione sconosciuta '$section' (backend)" >&2 && exit 2 ;;
	esac
done
