#!/usr/bin/env bash
# Contratto CI dei Projects: ./ci [sezione...]; senza argomenti esegue tutto.
# Esce con errore al primo controllo fallito. Nessun segreto.
set -euo pipefail
cd "$(dirname "$0")"

sections=("$@")
[ ${#sections[@]} -gt 0 ] || sections=(repo)

repo() {
  echo "== repo =="
  [ -f README.md ] || { echo "README.md mancante" >&2; exit 1; }
  [ -x ci ] || { echo "./ci non eseguibile" >&2; exit 1; }
  # .hs-tools: righe NOME VERSIONE PIATTAFORMA SHA256 URL
  if [ -f .hs-tools ]; then
    awk '!/^[[:space:]]*(#|$)/ && (NF != 5 || $5 !~ /^https:\/\// || $4 !~ /^[0-9a-f]{64}$/) \
      { print ".hs-tools riga " NR " non valida" > "/dev/stderr"; bad=1 } END { exit bad }' .hs-tools
  fi
}

for s in "${sections[@]}"; do
  case "$s" in
    repo) repo ;;
    *) echo "sezione sconosciuta: $s" >&2; exit 2 ;;
  esac
done
echo "ci: ok"
